### Login admin
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin"
}

> {%
    const setCookie = response.headers["set-cookie"];
    const match = setCookie && setCookie.match(/JSESSIONID=[^;]+/);
    if (match) {
        client.global.set("authCookie", match[0]);
    }
%}

### Get all users (admin only)
GET http://localhost:8080/api/users
Cookie: {{authCookie}}

### Get all roles
GET http://localhost:8080/api/users/roles
Cookie: {{authCookie}}

### Create new user
POST http://localhost:8080/api/users
Content-Type: application/json
Cookie: {{authCookie}}

{
  "username": "newuser",
  "password": "newpassword",
  "roleIds": [
    "00000000-0000-0000-0000-000000000001"
  ]
}

### Get user by ID (replace with actual user ID)
GET http://localhost:8080/api/users/{{userId}}
Cookie: {{authCookie}}

### Update existing user
PUT http://localhost:8080/api/users/{{userId}}
Content-Type: application/json
Cookie: {{authCookie}}

{
  "username": "updateduser",
  "password": "updatedpassword",
  "roleIds": [
    "00000000-0000-0000-0000-000000000001"
  ]
}

### Delete user by ID
DELETE http://localhost:8080/api/users/{{userId}}
Cookie: {{authCookie}}

### Logout
POST http://localhost:8080/api/auth/logout
Content-Type: application/json
Cookie: {{authCookie}}

### Create and extract new user ID
POST http://localhost:8080/api/users
Content-Type: application/json
Cookie: {{authCookie}}

{
  "username": "extractme",
  "password": "1234",
  "roleIds": [
    "00000000-0000-0000-0000-000000000001"
  ]
}

> {%
    const user = response.body;
    client.global.set("userId", user.id);
%}

